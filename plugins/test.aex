-- AEX Plugins Hub :: Test Plugin
-- Example plugin used to verify that the in-game Plugins Hub can list, download
-- and load a .aex file. The table format below is what AEX expects:
--   PluginName, PluginDescription, Commands = { [name] = { Aliases, Function, Description, ListName } }

local plugin = {
	PluginName = "Test Plugin",
	PluginDescription = "Example plugin from the AEX Plugins Hub (says hello world)",
	Version = "1.0.0",
	Author = "Sasha",
	Commands = {},
}

plugin.Commands["test"] = {
	Aliases = { "helloworld", "hubtest" },
	Description = "Prints hello world from the Plugins Hub test plugin",
	ListName = "test / helloworld / hubtest",
	Function = function(args, speaker)
		local who = "World"
		if args and args[1] then
			who = table.concat(args, " ")
		end
		local msg = "Hello, " .. tostring(who) .. "!"
		pcall(function()
			print("[AEX Plugins Hub / Test Plugin] " .. msg)
		end)
		pcall(function()
			if notify then
				notify("Test Plugin", msg)
			end
		end)
	end,
}

return plugin
